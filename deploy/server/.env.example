# Six-Faces, réglages du serveur. Copier en .env puis adapter.

# Obligatoire : le domaine (ou sous-domaine) qui pointe vers ce serveur, sans https://
DOMAIN=nouvelles.example.com

# --- Facultatif (les valeurs indiquées sont les valeurs par défaut) ---------------------------------

# Laisser les moteurs de recherche indexer le site
# ALLOW_INDEXING=false

# Nom et slogan affichés dans l'en-tête et les titres de page
# APP_NAME=Six-Faces
# APP_TAGLINE=La presse québécoise, sous toutes ses faces

# Fuseau horaire d'affichage
# DISPLAY_TZ=America/Toronto

# Collecte : intervalles en minutes, écart minimal en secondes entre deux requêtes vers un même site
# DISCOVER_INTERVAL_MINUTES=15
# GNEWS_INTERVAL_MINUTES=30
# PROCESS_INTERVAL_MINUTES=5
# HOST_DELAY_S=2.0
